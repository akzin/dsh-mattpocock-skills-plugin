{
  "name": "@akzin/dsh-mattpocock-skills-plugin",
  "version": "1.0.0",
  "description": "Matt Pocock's agent skills (mattpocock/skills, MIT) as a DeepSeek Harness bundle: all 38 skills in the global skill layer, on every surface.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "claude-code", "skills", "matt-pocock"],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akzin/dsh-mattpocock-skills-plugin.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
